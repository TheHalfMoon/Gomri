{
  "schemaVersion": 1,
  "product": {
    "name": "Gomrey",
    "slug": "gomrey",
    "repository": "https://github.com/TheHalfMoon/Gomrey"
  },
  "packages": {
    "root": "gomrey",
    "web": "gomrey-web",
    "backend": "gomrey-backend",
    "desktop": "gomrey"
  },
  "compatibility": {
    "canonicalEnvPrefix": "GOMREY_",
    "legacyEnvPrefix": "PRESENTON_",
    "legacyEnvPolicy": "preserve-as-compatibility-alias-until-a-versioned-removal-policy-is-canonical",
    "canonicalMcpRequestHeader": "X-Gomrey-MCP-Request",
    "legacyMcpRequestHeader": "X-Presenton-MCP-Request",
    "mcpRequestHeaderMigration": "P02-G2",
    "persistedProtocolMigration": "P02-G2b: canonical Gomrey writes with bounded Presenton legacy reads"
  },
  "provenance": {
    "primaryDonorName": "Presenton",
    "primaryDonorRepository": "presenton/presenton",
    "preservePaths": [
      "LICENSE",
      "NOTICE",
      "servers/fastapi/NOTICE",
      "docs/donors",
      "docs/SOURCE_LEDGER.md",
      "docs/evidence/P01_PRESENTON_IMPORT.md"
    ]
  },
  "thirdPartyContracts": [
    {
      "name": "@presenton/export-core",
      "policy": "preserve-until-a-separately-admitted-replacement-or-authorized-copy-is-qualified"
    }
  ],
  "deferredIdentity": {
    "desktopAppId": "P02-G3b: canonical non-store app ID io.github.thehalfmoon.gomrey; MAS legacy override until P02-G3c",
    "signingAndStoreIdentity": "P02-G3c",
    "binaryIconsAndInstallerArtwork": "P02-G3c",
    "releaseVersionReset": "P02-G4",
    "splashArtworkAsset": "P02-G3c: /Presenton_Splash.png donor binary remains unchanged until Gomrey artwork is admitted"
  },
  "desktopIdentity": {
    "canonicalAppId": "io.github.thehalfmoon.gomrey",
    "packageAndExecutableIdentity": "P02-G3b",
    "legacyStoreIdentityPolicy": "MAS/AppX donor identities remain bounded compatibility contracts until P02-G3c"
  }
}
