{
  "$id": "gomrey:v1:Job",
  "title": "Job",
  "version": 1,
  "type": "object",
  "required": ["job_id", "tenant_id", "workspace_id", "kind", "input_baseline", "idempotency_key", "status", "created_at"],
  "additionalProperties": false,
  "properties": {
    "job_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workspace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
    "input_baseline": { "type": "string", "minLength": 1, "maxLength": 256 },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 256 },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "suspended", "complete", "partial", "failed", "cancelled"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "deadline_at": { "type": "string", "format": "date-time" },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 }
  }
}
