{
  "$id": "gomrey:v1:DesignIR",
  "title": "DesignIR",
  "version": 1,
  "type": "object",
  "required": ["design_id", "artifact_id", "revision", "tenant_id", "workspace_id", "layout"],
  "additionalProperties": false,
  "properties": {
    "design_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "artifact_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "revision": { "type": "integer", "minimum": 1 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workspace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "layout": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tokens": {
      "type": "object",
      "additionalProperties": { "type": "string", "maxLength": 200 }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component_id", "component_type"],
        "additionalProperties": false,
        "properties": {
          "component_id": { "type": "string", "maxLength": 128 },
          "component_type": { "type": "string", "maxLength": 128 },
          "citation_ids": { "type": "array", "items": { "type": "string", "maxLength": 128 } }
        }
      }
    },
    "brand_skill_id": { "type": "string", "maxLength": 128 }
  }
}
