{
  "$id": "gomrey:v1:SourceArtifact",
  "title": "SourceArtifact",
  "version": 1,
  "$defs": {
    "digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "type": "string", "enum": ["sha256"] },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "type": "object",
  "required": ["source_id", "tenant_id", "workspace_id", "source_type", "original_digest", "revision", "created_at"],
  "additionalProperties": false,
  "properties": {
    "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workspace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_type": {
      "type": "string",
      "enum": ["pdf", "document", "web", "video", "audio", "spreadsheet", "image", "presentation", "connector", "other"]
    },
    "original_uri": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "original_digest": { "$ref": "#/$defs/digest" },
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "authors": { "type": "array", "items": { "type": "string", "maxLength": 300 } },
    "mime": { "type": "string", "minLength": 1, "maxLength": 128 },
    "languages": { "type": "array", "items": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" } },
    "access_class": { "type": "string", "enum": ["private", "workspace", "shared", "public"] },
    "redistribution": { "type": "string", "enum": ["allowed", "restricted", "prohibited"] },
    "parser_identities": { "type": "array", "items": { "type": "string", "maxLength": 200 } },
    "revision": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "acquired_at": { "type": "string", "format": "date-time" }
  }
}
