{
  "$id": "gomrey:v1:DecisionResult",
  "title": "DecisionResult",
  "version": 1,
  "type": "object",
  "required": ["request_id", "tenant_id", "workspace_id", "provider_identity", "model_revision", "selected_value", "data_boundary", "created_at"],
  "additionalProperties": false,
  "properties": {
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workspace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "provider_identity": { "type": "string", "minLength": 1, "maxLength": 200 },
    "model_identity": { "type": "string", "maxLength": 200 },
    "model_revision": { "type": "string", "minLength": 1, "maxLength": 200 },
    "selected_value": { "type": "string", "maxLength": 500 },
    "probabilities": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "calibration_profile": { "type": "string", "maxLength": 200 },
    "abstained": { "type": "boolean" },
    "out_of_distribution": { "type": "boolean" },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "warnings": { "type": "array", "items": { "type": "string", "maxLength": 500 } },
    "data_boundary": { "type": "string", "enum": ["local", "remote"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
