{
  "$id": "gomrey:v1:SourceUnit",
  "title": "SourceUnit",
  "version": 1,
  "type": "object",
  "required": ["source_id", "source_unit_id", "tenant_id", "workspace_id", "unit_kind", "state"],
  "additionalProperties": false,
  "properties": {
    "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_unit_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workspace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "unit_kind": {
      "type": "string",
      "enum": ["page", "section", "slide", "sheet", "segment", "scene", "range", "region", "item"]
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "sheet": { "type": "string", "maxLength": 200 },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 },
        "section": { "type": "string", "maxLength": 500 }
      }
    },
    "state": {
      "type": "string",
      "enum": ["declared", "accounted", "verified", "uncertain", "failed", "skipped", "duplicate"]
    },
    "skip_reason": { "type": "string", "maxLength": 500 },
    "content_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "parser_identity": { "type": "string", "maxLength": 200 }
  }
}
