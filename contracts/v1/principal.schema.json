{
  "$id": "gomrey:v1:Principal",
  "title": "Principal",
  "version": 1,
  "type": "object",
  "required": ["principal_id", "tenant_id", "kind", "created_at", "status"],
  "additionalProperties": false,
  "properties": {
    "principal_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "kind": { "type": "string", "enum": ["user", "agent", "service", "support"] },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "created_at": { "type": "string", "format": "date-time" },
    "revoked_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["active", "revoked"] }
  }
}
