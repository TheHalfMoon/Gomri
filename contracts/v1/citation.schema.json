{
  "$id": "gomrey:v1:Citation",
  "title": "Citation",
  "version": 1,
  "type": "object",
  "required": ["citation_id", "tenant_id", "workspace_id", "source_id", "source_unit_id", "locator"],
  "additionalProperties": false,
  "properties": {
    "citation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workspace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_unit_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "bundle_id": { "type": "string", "maxLength": 128 },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "paragraph": { "type": "integer", "minimum": 1 },
        "table": { "type": "string", "maxLength": 200 },
        "cell": { "type": "string", "maxLength": 100 },
        "region": { "type": "string", "maxLength": 200 },
        "url": { "type": "string", "format": "uri" },
        "dom_section": { "type": "string", "maxLength": 500 },
        "timestamp_ms": { "type": "integer", "minimum": 0 },
        "transcript_span": { "type": "string", "maxLength": 200 },
        "workbook": { "type": "string", "maxLength": 200 },
        "sheet": { "type": "string", "maxLength": 200 },
        "range": { "type": "string", "maxLength": 100 }
      }
    },
    "retrieval_snapshot": { "type": "string", "maxLength": 128 }
  }
}
