{
  "$id": "gomrey:v1:ArtifactBaseline",
  "title": "ArtifactBaseline",
  "version": 1,
  "type": "object",
  "required": ["baseline_id", "artifact_id", "revision", "tenant_id", "workspace_id", "content_digest", "created_at"],
  "additionalProperties": false,
  "properties": {
    "baseline_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "artifact_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "revision": { "type": "integer", "minimum": 1 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workspace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "content_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
