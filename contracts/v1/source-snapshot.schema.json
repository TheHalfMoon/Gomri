{
  "$id": "gomrey:v1:SourceSnapshot",
  "title": "SourceSnapshot",
  "version": 1,
  "type": "object",
  "required": ["snapshot_id", "source_id", "tenant_id", "workspace_id", "acquired_at", "content_digest", "revision"],
  "additionalProperties": false,
  "properties": {
    "snapshot_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workspace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "acquired_at": { "type": "string", "format": "date-time" },
    "content_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "acquisition_method": { "type": "string", "maxLength": 200 },
    "policy_ids": { "type": "array", "items": { "type": "string", "maxLength": 128 } }
  }
}
