{
  "$id": "gomrey:v1:EvidenceSpan",
  "title": "EvidenceSpan",
  "version": 1,
  "type": "object",
  "required": ["span_id", "source_id", "source_unit_id", "tenant_id", "workspace_id", "extracted_digest", "producer_identity"],
  "additionalProperties": false,
  "properties": {
    "span_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_unit_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workspace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "page": { "type": "integer", "minimum": 1 },
    "start_ms": { "type": "integer", "minimum": 0 },
    "end_ms": { "type": "integer", "minimum": 0 },
    "text_offsets": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "region": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },
    "text": { "type": "string", "maxLength": 20000 },
    "extracted_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "producer_identity": { "type": "string", "minLength": 1, "maxLength": 200 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "observations": { "type": "array", "items": { "type": "string", "maxLength": 500 } }
  }
}
